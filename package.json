{
  "name": "migris",
  "version": "1.0.0",
  "description": "Database migration tool with support for PostgreSQL, MySQL, and MongoDB",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "keywords": [
    "database",
    "migration",
    "postgresql",
    "mysql",
    "mongodb"
  ],
  "author": "",
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "prepare": "npm run build"
  },
  "dependencies": {
    "knex": "^3.1.0",
    "mongoose": "^8.1.0",
    "mysql2": "^3.6.0",
    "pino": "^8.17.0",
    "pg": "^8.11.3",
    "dotenv": "^16.4.1"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "prettier": "^3.2.5",
    "ts-jest": "^29.1.2",
    "typescript": "^5.3.3"
  }
}
